+/// Expressions that refer to a `let` are runtime expressions, also after
+/// override substitution. <https://github.com/gfx-rs/wgpu/issues/9002>
+#[cfg(all(test, feature = "wgsl-in"))]
+mod let_bound_overrides {
+    use alloc::{format, string::String};
+
+    use super::{process_overrides, PipelineConstantError};
+    use crate::{
+        back::PipelineConstants,
+        proc::ConstantEvaluatorError,
+        valid::{Capabilities, ValidationFlags, Validator},
+        Expression,
+    };
+
+    const PRELUDE: &str = "
+        const A = array<u32, 2>(10u, 20u);
+        @id(0) override O: u32 = 0u;
+        @group(0) @binding(0) var<storage, read_write> out: array<u32>;
+    ";
+
+    fn pipeline(body: &str, value: f64) -> Result<crate::Module, PipelineConstantError> {
+        let source = format!("{PRELUDE}\n@compute @workgroup_size(1) fn main() {{ {body} }}");
+        let module = crate::front::wgsl::parse_str(&source).unwrap();
+        let info = Validator::new(ValidationFlags::all(), Capabilities::default())
+            .validate(&module)
+            .unwrap();
+        let mut constants = PipelineConstants::default();
+        constants.insert(String::from("0"), value);
+        process_overrides(&module, &info, None, &constants).map(|(m, _)| m.into_owned())
+    }
+
+    fn entry_has_runtime_access(module: &crate::Module) -> bool {
+        module.entry_points[0]
+            .function
+            .expressions
+            .iter()
+            .any(|(_, e)| matches!(*e, Expression::Access { .. }))
+    }
+
+    #[test]
+    fn out_of_bounds_index_through_a_let_is_a_runtime_access() {
+        // `c + 1u` refers to a `let`, so it is a runtime expression: the access
+        // is guarded and never runs, and must not fail pipeline creation.
+        let body = "let c = O; if c + 1u < 2u { out[0] = A[c + 1u]; }";
+        let module = pipeline(body, 1.0).unwrap();
+        assert!(entry_has_runtime_access(&module));
+        pipeline(body, 0.0).unwrap();
+        // Also through a chain of `let`s.
+        pipeline(
+            "let c = O; let d = c * 2u; if d < 2u { out[0] = A[d]; }",
+            1.0,
+        )
+        .unwrap();
+    }
+
+    #[test]
+    fn division_by_zero_through_a_let_is_a_runtime_division() {
+        pipeline("let d = O; out[0] = 10u / d;", 0.0).unwrap();
+    }
+
+    #[test]
+    fn override_expressions_are_still_evaluated() {
+        // No `let`: these are override-expressions, evaluated (and rejected)
+        // at pipeline creation.
+        assert_eq!(
+            pipeline("if O + 1u < 2u { out[0] = A[O + 1u]; }", 1.0).unwrap_err(),
+            PipelineConstantError::ConstantEvaluatorError(
+                ConstantEvaluatorError::InvalidAccessIndex
+            )
+        );
+        assert!(pipeline("out[0] = 10u / O;", 0.0).is_err());
+        // A `let` initializer is an override-expression too.
+        assert!(pipeline("let d = 10u / O; out[0] = d;", 0.0).is_err());
+        // In-bounds override-expressions are folded as before.
+        let module = pipeline("out[0] = A[O];", 1.0).unwrap();
+        assert!(!entry_has_runtime_access(&module));
+    }
 }
