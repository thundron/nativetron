+/// WGSL §9.7 behavior analysis decides whether the end of a function with a return type
+/// is reachable ("missing return"). <https://github.com/gfx-rs/wgpu/issues/9501>
+mod behavior_analysis {
+    use alloc::{format, string::String};
+
+    use super::parse_str;
+    use crate::valid::{Capabilities, ValidationFlags, Validator};
+    use crate::{Expression, Statement};
+
+    fn validate(source: &str) -> Result<crate::Module, String> {
+        let module = parse_str(source).map_err(|e| e.emit_to_string(source))?;
+        Validator::new(ValidationFlags::all(), Capabilities::default())
+            .validate(&module)
+            .map_err(|e| format!("{:?}", e.into_inner()))?;
+        Ok(module)
+    }
+
+    #[track_caller]
+    fn valid(source: &str) -> crate::Module {
+        match validate(source) {
+            Ok(module) => module,
+            Err(e) => panic!("expected a valid module, got {e}\n{source}"),
+        }
+    }
+
+    /// The function still ends where control can fall off its end: the validator rejects
+    /// the value-less `return` that marks it, exactly as before.
+    #[track_caller]
+    fn missing_return(source: &str) {
+        match validate(source) {
+            Ok(_) => panic!("expected a missing-return error\n{source}"),
+            Err(e) => assert!(
+                e.contains("InvalidReturnType") && e.contains("expression: None"),
+                "unexpected error {e}\n{source}"
+            ),
+        }
+    }
+
+    const PRELUDE: &str = "@group(0) @binding(0) var<storage, read_write> buf: array<u32, 4>;\n";
+
+    fn with_prelude(body: &str) -> String {
+        format!("{PRELUDE}{body}")
+    }
+
+    #[test]
+    fn loop_left_only_through_return() {
+        // The repro from gfx-rs/wgpu#9501.
+        valid(
+            "fn f(n: u32) -> u32 {
+                var i = 0u;
+                loop {
+                    if i >= n { return i; }
+                    i = i + 1u;
+                }
+            }",
+        );
+        // `continue`, nested `if`s and an atomic retry loop, as in open-addressing hash
+        // table inserts.
+        valid(&with_prelude(
+            "var<workgroup> tbl: array<atomic<u32>, 64>;
+            fn insert(key: u32) -> vec3u {
+                var i = 0u;
+                loop {
+                    if i >= 64u { return vec3u(0xffffffffu, 0u, 0u); }
+                    let k = atomicLoad(&tbl[i]);
+                    if k == key { return vec3u(i, 0u, 0u); }
+                    if k == 0u {
+                        let r = atomicCompareExchangeWeak(&tbl[i], 0u, key);
+                        if r.exchanged { return vec3u(i, 1u, 0u); }
+                        if r.old_value == key { return vec3u(i, 0u, 0u); }
+                        if r.old_value == 0u { continue; }
+                    }
+                    i += 1u;
+                }
+            }",
+        ));
+        valid("fn f(c: bool) -> i32 { for (;;) { if c { return 1; } } }");
+        valid("fn f(c: bool) -> i32 { for (var i = 0; ; i++) { if c { return i; } } }");
+        // The body always returns, so the continuing block (and its `break if`) is never reached.
+        valid("fn f() -> i32 { loop { return 1; continuing { break if true; } } }");
+    }
+
+    #[test]
+    fn break_of_an_inner_construct_does_not_leave_the_loop() {
+        valid(
+            "fn f(x: u32) -> u32 {
+                loop {
+                    switch x { case 0u: { break; } default: { return 1u; } }
+                }
+            }",
+        );
+        valid(
+            "fn f(x: u32) -> u32 {
+                loop {
+                    loop { if x > 2u { break; } return 2u; }
+                    if x == 7u { return 1u; }
+                }
+            }",
+        );
+    }
+
+    #[test]
+    fn unreachable_end_in_nested_tails() {
+        valid(
+            "fn f(c: bool) -> f32 {
+                if c { loop { if c { return 1.0; } } } else { return 2.0; }
+            }",
+        );
+        valid(
+            "fn f(x: i32) -> i32 {
+                switch x {
+                    case 0, 1: { loop { if x == 0 { return 3; } } }
+                    default: { return 2; }
+                }
+            }",
+        );
+        valid("fn f(c: bool) -> i32 { { if c { return 1; } loop { return 2; } } }");
+    }
+
+    #[test]
+    fn statically_unreachable_code_after_return() {
+        // The examples of WGSL §9.7.3.
+        valid("fn simple() -> i32 { var a: i32; return 0; a = 1; return 2; }");
+        valid("fn simple() -> i32 { var a: i32; return 0; a = 1; }");
+        valid("fn nested() -> i32 { var a: i32; { a = 2; return 1; } a = 1; }");
+        valid("fn f(c: bool) -> i32 { loop { if c { return 1; } } var a = 0; a = 1; }");
+    }
+
+    #[test]
+    fn reachable_end_is_still_a_missing_return() {
+        missing_return("fn f() -> u32 { }");
+        missing_return("fn f(c: bool) -> u32 { if c { return 1u; } }");
+        // The loop has a `break`.
+        missing_return("fn f(c: bool) -> u32 { loop { if c { break; } return 1u; } }");
+        missing_return("fn f(c: bool) -> u32 { loop { if c { return 1u; } if !c { break; } } }");
+        // `while` and `for` with a condition leave the loop when it is false.
+        missing_return("fn f(c: bool) -> u32 { while c { return 1u; } }");
+        missing_return("fn f(n: u32) -> u32 { for (var i = 0u; i < n; i++) { return i; } }");
+        // `break if` leaves the loop when the body can reach the continuing block.
+        missing_return(
+            "fn f(c: bool) -> u32 { loop { if c { return 1u; } continuing { break if !c; } } }",
+        );
+        // Only one branch ends in a loop that never completes.
+        missing_return("fn f(c: bool) -> u32 { if c { loop { return 1u; } } }");
+        missing_return(
+            "fn f(c: bool) -> u32 { if c { loop { return 1u; } } else { var a = 0; a = 1; } }",
+        );
+    }
+
+    #[test]
+    fn loops_with_empty_behavior_are_not_trusted() {
+        // §9.7 gives these loops an empty behavior, which makes the module invalid; they
+        // must not count as proof that the end of the function is unreachable.
+        missing_return("fn f() -> u32 { loop { } }");
+        missing_return("fn f() -> u32 { loop { continue; } }");
+        missing_return("fn f() -> f32 { loop { discard; } }");
+        missing_return("fn f(x: u32) -> u32 { loop { switch x { default: { break; } } } }");
+        missing_return("fn f(c: bool) -> u32 { if c { loop { } } loop { return 1u; } }");
+        missing_return("fn f(c: bool) -> u32 { for (;;) { } }");
+    }
+
+    #[test]
+    fn behaviors_follow_the_specification_table() {
+        use crate::proc::{block_behavior, Behavior as B};
+        let cases: &[(&str, Option<B>)] = &[
+            ("{ }", Some(B::NEXT)),
+            ("{ return; }", Some(B::RETURN)),
+            ("{ return; buf[0] = 1u; }", Some(B::RETURN)),
+            ("if c { return; }", Some(B::NEXT | B::RETURN)),
+            ("if c { return; } else { return; }", Some(B::RETURN)),
+            ("loop { if c { break; } }", Some(B::NEXT)),
+            ("loop { if c { return; } }", Some(B::RETURN)),
+            (
+                "loop { if c { return; } if !c { continue; } }",
+                Some(B::RETURN),
+            ),
+            (
+                "loop { if c { return; } continuing { break if c; } }",
+                Some(B::NEXT | B::RETURN),
+            ),
+            (
+                "loop { return; continuing { break if true; } }",
+                Some(B::RETURN),
+            ),
+            ("loop { loop { break; } return; }", Some(B::RETURN)),
+            ("while c { return; }", Some(B::NEXT | B::RETURN)),
+            ("for (;;) { return; }", Some(B::RETURN)),
+            (
+                "switch x { case 0: { return; } default: { break; } }",
+                Some(B::NEXT | B::RETURN),
+            ),
+            (
+                "switch x { case 0, 1: { return; } default: { return; } }",
+                Some(B::RETURN),
+            ),
+            (
+                "loop { switch x { default: { break; } } if c { return; } }",
+                Some(B::RETURN),
+            ),
+            ("discard;", Some(B::NEXT)),
+            ("loop { }", None),
+            ("loop { continue; }", None),
+            ("{ return; loop { } }", None),
+        ];
+        for &(construct, expected) in cases {
+            let source = alloc::format!("{PRELUDE}fn f(c: bool, x: i32) {{ {construct} return; }}");
+            let module = parse_str(&source).unwrap();
+            let (_, f) = module.functions.iter().next().unwrap();
+            let first = crate::Block::from_vec(alloc::vec![f.body[0].clone()]);
+            assert_eq!(block_behavior(&first), expected, "{construct}");
+        }
+    }
+
+    #[test]
+    fn void_functions_and_previously_valid_functions_are_unchanged() {
+        // A void function always gets the value-less return, as before.
+        let module = valid("fn f(c: bool) { loop { if c { return; } } }");
+        let (_, f) = module.functions.iter().next().unwrap();
+        assert!(matches!(
+            f.body.last(),
+            Some(&Statement::Return { value: None })
+        ));
+        assert!(!f
+            .expressions
+            .iter()
+            .any(|(_, e)| matches!(*e, Expression::ZeroValue(_))));
+        // A function that already validated gets nothing appended.
+        let module = valid("fn f(c: bool) -> u32 { if c { return 1u; } else { return 2u; } }");
+        let (_, f) = module.functions.iter().next().unwrap();
+        assert!(matches!(f.body.last(), Some(&Statement::If { .. })));
+        assert!(!f
+            .expressions
+            .iter()
+            .any(|(_, e)| matches!(*e, Expression::ZeroValue(_))));
+    }
+
+    #[test]
+    fn unreachable_end_gets_a_typed_return() {
+        let module = valid("fn f(c: bool) -> vec2u { loop { if c { return vec2u(1u); } } }");
+        let (_, f) = module.functions.iter().next().unwrap();
+        let ty = f.result.as_ref().unwrap().ty;
+        let mut statements = f.body.iter().rev();
+        match statements.next() {
+            Some(&Statement::Return { value: Some(v) }) => {
+                assert!(matches!(f.expressions[v], Expression::ZeroValue(t) if t == ty));
+            }
+            other => panic!("expected a zero-value return, got {other:?}"),
+        }
+        assert!(matches!(statements.next(), Some(&Statement::Loop { .. })));
+        // One shared expression, however many tails need it.
+        let module = valid(
+            "fn f(c: bool) -> i32 {
+                if c { loop { if c { return 1; } } } else { loop { return 2; } }
+            }",
+        );
+        let (_, f) = module.functions.iter().next().unwrap();
+        let zeros = f
+            .expressions
+            .iter()
+            .filter(|&(_, e)| matches!(*e, Expression::ZeroValue(_)))
+            .count();
+        assert_eq!(zeros, 1);
+    }
+}
