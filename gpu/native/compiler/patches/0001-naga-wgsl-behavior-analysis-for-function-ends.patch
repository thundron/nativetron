+bitflags::bitflags! {
+    /// A statement behavior: the set of ways in which execution can leave a statement.
+    ///
+    /// See [WGSL §9.7 "Statements Behavior Analysis"](https://www.w3.org/TR/WGSL/#behaviors).
+    #[derive(Clone, Copy, Debug, Eq, PartialEq)]
+    pub(crate) struct Behavior: u8 {
+        /// Execution falls through to the next statement.
+        const NEXT = 1 << 0;
+        /// Execution leaves through `break` (or `break if`) to the enclosing loop or switch.
+        const BREAK = 1 << 1;
+        /// Execution leaves through `continue` to the enclosing loop.
+        const CONTINUE = 1 << 2;
+        /// Execution leaves the function through `return`.
+        const RETURN = 1 << 3;
+    }
+}
+
+/// Compute the behavior of `block` according to the rules of
+/// [WGSL §9.7](https://www.w3.org/TR/WGSL/#behaviors), applied to Naga IR.
+///
+/// Returns `None` when the rules give some statement (reachable or not) an empty
+/// behavior, or give a `continuing` block a behavior containing `Continue` or `Return`:
+/// such programs are invalid under §9.7, so callers must not draw conclusions from them.
+///
+/// The WGSL front end lowers every construct that §9.7 desugars into an IR construct
+/// with the same behavior: `for` and `while` become a [`Loop`] whose body starts with
+/// an [`If`] containing [`Break`], `break if` becomes [`Loop::break_if`], a clause
+/// with several selectors becomes [`fall_through`] cases with empty bodies, and
+/// `discard` becomes [`Kill`], which has behavior {Next} as in §9.7. Statements that
+/// do not affect control flow, and calls (whose callee behavior is {Next} in every
+/// valid module), have behavior {Next}.
+///
+/// The result is sound for reachability: if `Next` is not in the behavior, execution
+/// can never fall through the end of `block`.
+///
+/// [`Loop`]: crate::Statement::Loop
+/// [`Loop::break_if`]: crate::Statement::Loop
+/// [`If`]: crate::Statement::If
+/// [`Break`]: crate::Statement::Break
+/// [`Kill`]: crate::Statement::Kill
+/// [`fall_through`]: crate::SwitchCase::fall_through
+pub(crate) fn block_behavior(block: &crate::Block) -> Option<Behavior> {
+    // `s1 s2`: (B1 \ {Next}) ∪ B2 when Next ∈ B1, else B1. Every statement must have a
+    // non-empty behavior even when it is statically unreachable, so all are analyzed.
+    let mut behavior = Behavior::NEXT;
+    for statement in block.iter() {
+        let b = statement_behavior(statement)?;
+        if behavior.contains(Behavior::NEXT) {
+            behavior = (behavior - Behavior::NEXT) | b;
+        }
+    }
+    Some(behavior)
+}
+
+fn statement_behavior(statement: &crate::Statement) -> Option<Behavior> {
+    use crate::Statement as S;
+    let behavior = match *statement {
+        S::Block(ref block) => block_behavior(block)?,
+        // A missing `else` is an empty block, whose behavior is {Next}.
+        S::If {
+            condition: _,
+            ref accept,
+            ref reject,
+        } => block_behavior(accept)? | block_behavior(reject)?,
+        S::Switch {
+            selector: _,
+            ref cases,
+        } => {
+            let mut all = Behavior::empty();
+            for case in cases {
+                let b = block_behavior(&case.body)?;
+                // A fall-through case is one selector of a multi-selector clause: it
+                // continues into the next case, whose behavior is counted there.
+                all |= if case.fall_through {
+                    b - Behavior::NEXT
+                } else {
+                    b
+                };
+            }
+            if all.contains(Behavior::BREAK) {
+                (all | Behavior::NEXT) - Behavior::BREAK
+            } else {
+                all
+            }
+        }
+        S::Loop {
+            ref body,
+            ref continuing,
+            break_if,
+        } => {
+            let b1 = block_behavior(body)?;
+            let mut b2 = block_behavior(continuing)?;
+            // `break if e;` ends the continuing block and has behavior {Break, Next}.
+            if break_if.is_some() && b2.contains(Behavior::NEXT) {
+                b2 |= Behavior::BREAK;
+            }
+            if b2.intersects(Behavior::CONTINUE | Behavior::RETURN) {
+                return None;
+            }
+            if b1 == Behavior::RETURN {
+                Behavior::RETURN
+            } else if (b1 | b2).contains(Behavior::BREAK) {
+                (b1 | b2 | Behavior::NEXT) - (Behavior::BREAK | Behavior::CONTINUE)
+            } else {
+                (b1 | b2) - (Behavior::CONTINUE | Behavior::NEXT)
+            }
+        }
+        S::Break => Behavior::BREAK,
+        S::Continue => Behavior::CONTINUE,
+        S::Return { .. } => Behavior::RETURN,
+        S::Kill
+        | S::Emit(_)
+        | S::Store { .. }
+        | S::ImageStore { .. }
+        | S::Call { .. }
+        | S::RayQuery { .. }
+        | S::Atomic { .. }
+        | S::ImageAtomic { .. }
+        | S::WorkGroupUniformLoad { .. }
+        | S::SubgroupBallot { .. }
+        | S::SubgroupCollectiveOperation { .. }
+        | S::SubgroupGather { .. }
+        | S::ControlBarrier(_)
+        | S::MemoryBarrier(_)
+        | S::CooperativeStore { .. }
+        | S::RayPipelineFunction(_) => Behavior::NEXT,
+    };
+    if behavior.is_empty() {
+        None
+    } else {
+        Some(behavior)
+    }
+}
